APP_NAME=conciliador-migrator
APP_ENV=dev

# PostgreSQL - Banco próprio do migrador
DB_DRIVER=pgsql
DB_HOST=migrator-postgres
DB_PORT=5432
DB_DATABASE=conciliador
DB_USERNAME=conciliador
DB_PASSWORD=conciliador
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_PREFIX=
DB_MAX_IDLE_TIME=60
DB_POOL_MIN=4
DB_POOL_MAX=40

# PostgreSQL - Banco do Conciliador Web (destino da migração)
DB_WEB_HOST=postgres
DB_WEB_PORT=5432
DB_WEB_DATABASE=conciliador
DB_WEB_USERNAME=postgres
DB_WEB_PASSWORD=conciliador
DB_WEB_POOL_MIN=5
DB_WEB_POOL_MAX=30
DB_WEB_MAX_IDLE_TIME=60

# Redis
REDIS_HOST=redis
REDIS_AUTH=(null)
REDIS_PORT=6380
REDIS_DB=5

# API Key Authentication
# X-Api-Key deve conter o payload criptografado em AES-256-GCM no formato v1.<iv>.<tag>.<ciphertext>.
# O payload descriptografado pode ser a API key pura ou JSON: {"api_key":"...","contract_id":"...","user_id":"...","exp":1893456000}
MIGRATION_API_KEY=change-this-to-a-secure-random-string
MIGRATION_API_KEYS=
MIGRATION_API_KEY_ENCRYPTION_KEY=change-this-to-a-secure-encryption-key
MIGRATION_API_KEY_HEADER=X-Api-Key

# Migration Settings
MIGRATION_CHUNK_SIZE=1000
MIGRATION_MAX_COROUTINES=8
MIGRATION_RATE_LIMIT=60
MIGRATION_BULK_RATE_LIMIT=700

# Discord Notifications
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFICATIONS_ENABLED=true

# Pull-Mode Legacy Databases (whitelist)
# CSV de nomes lógicos; para cada nome, definir o conjunto correspondente em UPPERCASE:
#   LEGACY_DB_<NOME>_HOST, _PORT, _DATABASE, _USERNAME, _PASSWORD
# Exemplo:
#   LEGACY_DBS=cliente_x,cliente_y
#   LEGACY_DB_CLIENTE_X_HOST=192.168.0.10
#   LEGACY_DB_CLIENTE_X_PORT=5432
#   LEGACY_DB_CLIENTE_X_DATABASE=conciliador_legado_x
#   LEGACY_DB_CLIENTE_X_USERNAME=migrator_ro
#   LEGACY_DB_CLIENTE_X_PASSWORD=xxx
LEGACY_DBS=
